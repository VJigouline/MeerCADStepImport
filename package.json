{
  "name": "meercad-step-import",
  "version": "1.0.0",
  "description": "STEP (ISO 10303-21) importer for three.js in TypeScript: reads AP203, AP214 and AP242 files, tessellates B-rep solids with analytic and NURBS surfaces, and builds the product and assembly structure, colours and units without WASM.",
  "keywords": [
    "step",
    "stp",
    "iso-10303",
    "ap203",
    "ap214",
    "ap242",
    "cad",
    "brep",
    "nurbs",
    "three",
    "threejs",
    "importer",
    "loader",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "Documentation",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VJigouline/MeerCADStepImport.git"
  }
}
